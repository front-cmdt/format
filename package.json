{
  "name": "@front-cmdt/format",
  "version": "1.6.0",
  "description": "Shared Prettier and Stylelint configs with import sorting, Tailwind CSS class ordering, SCSS and Astro support",
  "homepage": "https://github.com/front-cmdt/format#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/front-cmdt/format.git"
  },
  "bugs": {
    "url": "https://github.com/front-cmdt/format/issues"
  },
  "keywords": [
    "prettier",
    "trivago",
    "prettier-plugin-sort-imports",
    "tailwindcss",
    "prettier-plugin-tailwindcss",
    "lint",
    "linting",
    "format",
    "formatting",
    "code style",
    "code formatting",
    "code styling",
    "stylelint",
    "stylelint-config",
    "stylelint-scss",
    "scss lint",
    "scss linting",
    "css lint",
    "css linting",
    "astro",
    "astro plugin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "peerDependencies": {
    "prettier": "^3.0.0",
    "sass": "^1.5.0"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "postcss-scss": "4.0.9",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "stylelint": "17.1.1",
    "stylelint-config-clean-order": "8.0.0",
    "stylelint-order": "7.0.1",
    "stylelint-scss": "7.0.0"
  },
  "main": "./dist/prettier.config.cjs",
  "module": "./dist/prettier.config.js",
  "types": "./dist/prettier.config.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/prettier.config.mjs src/stylelint.config.mjs --format esm,cjs --dts --clean --shims",
    "release:patch": "yarn build && npm version patch -m \"release: v%s\" && git push --follow-tags",
    "release:minor": "yarn build && npm version minor -m \"release: v%s\" && git push --follow-tags",
    "release:major": "yarn build && npm version major -m \"release: v%s\" && git push --follow-tags",
    "release:push": "git push --follow-tags",
    "pub:local": "npm run build && yalc push"
  },
  "exports": {
    "./prettier": {
      "import": {
        "types": "./dist/prettier.config.d.ts",
        "default": "./dist/prettier.config.js"
      },
      "require": {
        "types": "./dist/prettier.config.d.cts",
        "default": "./dist/prettier.config.cjs"
      }
    },
    "./stylelint": {
      "import": {
        "types": "./dist/stylelint.config.d.ts",
        "default": "./dist/stylelint.config.js"
      },
      "require": {
        "types": "./dist/stylelint.config.d.cts",
        "default": "./dist/stylelint.config.cjs"
      }
    }
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "yalc": "^1.0.0-pre.53"
  }
}
